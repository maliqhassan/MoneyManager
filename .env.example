# -----------------------------------------------------------------------------
# Environment variables
#
# Copy to `.env.local` for local development (git-ignored). Never commit real
# values. For EAS builds, configure these per environment (development /
# preview / production) with `eas env:create` or the Expo dashboard.
#
# Only variables prefixed with EXPO_PUBLIC_ are embedded in the app bundle.
# Treat every EXPO_PUBLIC_ value as public — never put a secret here
# (no Supabase service-role key, no OAuth client secrets).
# -----------------------------------------------------------------------------

# Which backend environment this build talks to: development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Supabase project URL (Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (formerly "anon" key). Safe to ship: access is
# enforced by Row Level Security, not by this key.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional: Sentry DSN. Leave empty to disable error reporting.
EXPO_PUBLIC_SENTRY_DSN=
